rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && data.displayName is string && data.displayName.size() <= 100
        && data.createdAt == request.time;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'amount', 'category', 'date', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 7 && data.keys().size() <= 8 // optional notes
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 50
        && data.date is string // format checked by client, but string check here
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'category', 'limit', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.category is string && data.category.size() <= 50
        && data.limit is number && data.limit >= 0;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email'])
        && isValidUser(incoming()); // partial valid check omitted for simplicity but schema check remains
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidExpense(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'category', 'date', 'notes', 'updatedAt']);

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /budgets/{budgetId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(budgetId)
        && isValidBudget(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidBudget(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['limit', 'updatedAt']);

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
